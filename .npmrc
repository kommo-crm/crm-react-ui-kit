# This repo is managed with yarn workspaces. yarn tolerates the peer-dependency
# mismatch between eslint@9 and eslint-plugin-react-hooks@4 (which only supports
# eslint <= 8), but npm errors on ERESOLVE. The publish flow (`make minor` /
# `make patch`) runs `npm version`, which reconciles node_modules and hits that
# conflict. Match yarn's leniency so publishing works.
legacy-peer-deps=true
# Don't let npm write its own lockfile; yarn.lock is the source of truth.
package-lock=false
